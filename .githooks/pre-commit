#!/bin/bash

set -e

echo "🔧 Running pre-commit checks..."

# Store the current diff to check for changes after formatting
INITIAL_DIFF=$(git diff --name-only)

echo "📝 Running code formatting..."
make fmt

# Check if formatting made any changes
AFTER_FMT_DIFF=$(git diff --name-only)
if [ "$INITIAL_DIFF" != "$AFTER_FMT_DIFF" ] || [ -n "$(git diff --name-only)" ]; then
    echo ""
    echo "❌ Code formatting made changes. Please review and stage the changes:"
    echo ""
    git diff --name-only | sed 's/^/  - /'
    echo ""
    echo "💡 Run 'git add .' to stage the formatted changes and commit again."
    exit 1
fi

echo "✅ Code formatting is up to date"

echo "🔍 Running linting checks..."
make lint

echo ""
echo "✅ All pre-commit checks passed! 🎉"
exit 0