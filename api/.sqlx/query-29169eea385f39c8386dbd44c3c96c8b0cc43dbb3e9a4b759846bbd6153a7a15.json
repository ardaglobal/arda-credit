{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT \n            id,\n            borrower_id,\n            lender_id,\n            principal_amount,\n            outstanding_balance,\n            interest_rate_bps,\n            loan_status,\n            originated_at,\n            maturity_date,\n            created_at,\n            updated_at\n        FROM loans\n        WHERE ($1::text IS NULL OR loan_status = $1)\n          AND ($2::uuid IS NULL OR borrower_id = $2)\n          AND ($3::uuid IS NULL OR lender_id = $3)\n        ORDER BY created_at DESC\n        LIMIT $4 OFFSET $5\n        ",
