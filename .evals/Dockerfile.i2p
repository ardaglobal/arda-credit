# Multi-stage image for i2p service
FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git ripgrep && \
    rm -rf /var/lib/apt/lists/*

# Install ast-grep (sg) CLI
RUN set -eux; \
    ARCH="$(uname -m)"; \
    if [ "$ARCH" = "x86_64" ]; then AG_ARCH="x86_64-unknown-linux-gnu"; \
    elif [ "$ARCH" = "aarch64" ] || [ "$ARCH" = "arm64" ]; then AG_ARCH="aarch64-unknown-linux-gnu"; \
    else echo "Unsupported arch: $ARCH" && exit 1; fi; \
    AG_VER="v0.24.3"; \
    curl -fsSL -o /tmp/ast-grep.tar.gz "https://github.com/ast-grep/ast-grep/releases/download/${AG_VER}/ast-grep-${AG_ARCH}.tar.gz"; \
    tar -xzf /tmp/ast-grep.tar.gz -C /tmp; \
    mv /tmp/ast-grep-*/sg /usr/local/bin/sg; \
    chmod +x /usr/local/bin/sg; \
    ln -s /usr/local/bin/sg /usr/local/bin/ast-grep; \
    rm -rf /tmp/ast-grep*
WORKDIR /app

# Copy only i2p assets to speed builds
COPY .evals/requirements-service.txt /app/.evals/requirements-service.txt
RUN pip install -r /app/.evals/requirements-service.txt

# Copy repo (needed so i2p can scan codebase via code2prompt fallback)
COPY . /app

# Expose service port
EXPOSE 8081

ENV REPO_ROOT=/app \
    I2P_SERVICE_PORT=8081

# Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD curl -fsS http://127.0.0.1:8081/health || exit 1

CMD ["uvicorn", ".evals.i2p_service:app", "--host", "0.0.0.0", "--port", "8081"]
