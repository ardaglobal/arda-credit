// Enhanced JWT token validation with comprehensive logging
#[instrument(skip(token, validation_key), fields(
    user_id = tracing::field::Empty,
    token_exp = tracing::field::Empty,
    token_iat = tracing::field::Empty,
    validation_time_ms = tracing::field::Empty,
    auth_success = tracing::field::Empty
), level = "info")]
pub async fn validate_jwt_token(token: &str, validation_key: &DecodingKey) -> Result<Claims, AuthError> {
    let start_time = Instant::now();
    let span = tracing::Span::current();
    
    // Validate token structure and signature
    let token_data = decode::<Claims>(token, validation_key, &Validation::new(Algorithm::HS256))?;
    
    // Record security metrics
    span.record("user_id", &token_data.claims.sub);
    span.record("token_exp", &token_data.claims.exp);
    span.record("token_iat", &token_data.claims.iat);
    span.record("validation_time_ms", &start_time.elapsed().as_millis());
    span.record("auth_success", &true);
    
    // Track authentication events
    counter!("arda_credit.auth.token_validation.success", 1);
    histogram!("arda_credit.auth.validation_duration_ms", start_time.elapsed().as_millis() as f64);
    
    Ok(token_data.claims)
}
```

