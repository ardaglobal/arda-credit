// 4. Implement anomaly detection for suspicious behavior
#[derive(Debug)]
pub struct SecurityEvent {
    pub event_type: SecurityEventType,
    pub user_id: Option<Uuid>,
    pub ip_address: IpAddr,
    pub timestamp: DateTime<Utc>,
    pub severity: SecuritySeverity,
    pub details: serde_json::Value,
}

#[instrument(skip(event), fields(
    event_type = ?event.event_type,
    severity = ?event.severity,
    user_id = ?event.user_id
))]
pub async fn process_security_event(event: SecurityEvent) -> Result<(), SecurityError> {
    // Log security event
    match event.severity {
        SecuritySeverity::Critical => {
            error!(security_event = ?event, "Critical security event detected");
            counter!("arda_credit.security.events.critical", 1);
            
            // Immediate response for critical events
            trigger_security_alert(&event).await?;
        },
        SecuritySeverity::High => {
            warn!(security_event = ?event, "High severity security event");
            counter!("arda_credit.security.events.high", 1);
        },
        SecuritySeverity::Medium => {
            info!(security_event = ?event, "Medium severity security event");
            counter!("arda_credit.security.events.medium", 1);
        },
        SecuritySeverity::Low => {
            debug!(security_event = ?event, "Low severity security event");
            counter!("arda_credit.security.events.low", 1);
        },
    }
    
    Ok(())
}
```

