// 1. Enhanced JWT security with refresh token rotation
pub struct EnhancedJwtClaims {
    pub sub: String,          // User ID
    pub exp: u64,            // Expiration time
    pub iat: u64,            // Issued at time
    pub jti: String,         // JWT ID for revocation
    pub kyc_status: String,  // KYC status at token issue time
    pub permissions: Vec<String>, // User permissions
}

// 2. Implement token blacklist for security
#[instrument(skip(redis_pool), fields(token_id = %token_id))]
pub async fn revoke_jwt_token(redis_pool: &RedisPool, token_id: &str, exp: u64) -> Result<(), AuthError> {
    let ttl = exp.saturating_sub(SystemTime::now().duration_since(UNIX_EPOCH)?.as_secs());
    redis_pool.setex(format!("revoked_token:{}", token_id), ttl, "1").await?;
    
    counter!("arda_credit.auth.tokens.revoked", 1);
    info!(token_id = token_id, "JWT token revoked");
    
    Ok(())
}
```

