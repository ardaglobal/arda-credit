#[instrument(skip(req), fields(
    client_ip = %client_ip,
    endpoint = %endpoint,
    rate_limit_remaining = tracing::field::Empty,
    rate_limit_reset = tracing::field::Empty,
    blocked = tracing::field::Empty
), level = "debug")]
pub async fn apply_rate_limit(req: Request<Body>, client_ip: IpAddr, endpoint: &str) -> Result<Request<Body>, RateLimitError> {
    let span = tracing::Span::current();
    
    // Check rate limit for client IP and endpoint
    let rate_limit_status = check_rate_limit(client_ip, endpoint).await?;
    
    if rate_limit_status.blocked {
        span.record("blocked", &true);
        span.record("rate_limit_remaining", &0);
        
        // Track rate limit violations
        counter!("arda_credit.security.rate_limit.blocked", 1, 
            "endpoint" => endpoint,
            "client_ip" => client_ip.to_string()
        );
        
        warn!(
            client_ip = %client_ip,
            endpoint = %endpoint,
            "Rate limit exceeded"
        );
        
        return Err(RateLimitError::ExceededLimit);
    }
    
    span.record("blocked", &false);
    span.record("rate_limit_remaining", &rate_limit_status.remaining);
    span.record("rate_limit_reset", &rate_limit_status.reset_at);
    
    Ok(req)
}
```

