# Build stage - build only the db crate and populate_fake_data binary
FROM ghcr.io/ardaglobal/base-containers/rust-sp1-base:latest AS builder

WORKDIR /app

# Create a minimal workspace Cargo.toml that only includes the necessary crates and their dependencies
RUN echo '[workspace]\nmembers = ["db", "lib"]\n[workspace.dependencies]\nalloy-consensus = "1.0"\nalloy-contract = "1.0"\nalloy-json-rpc = "1.0"\nalloy-network = "1.0"\nalloy-primitives = "1.3.0"\nalloy-provider = "1.0.24"\nalloy-rpc-types = "1.0"\nalloy-rpc-types-eth = "1.0"\nalloy-signer = "1.0"\nalloy-signer-local = "1.0"\nalloy-sol-types = "1.0"\nalloy-transport = "1.0"\nalloy-transport-http = "1.0"\nanyhow = "1.0"\naxum = "0.8.4"\nbincode = "2.0.1"\nchrono = "0.4"\nclap = "4.5.47"\ndotenv = "0.15.0"\neyre = "0.6"\nfutures = "0.3"\nhex = "0.4.3"\nonce_cell = "1.20"\nparking_lot = "0.12.4"\nreqwest = "0.12"\nrust_decimal = "1.38"\nserde = { version = "1.0.219", default-features = false, features = ["derive"] }\nserde_json = { version = "1.0.145", default-features = false, features = ["alloc"] }\nsha2 = "0.10"\nsindri = "0.3.1"\nsp1-build = "5.2.1"\nsp1-sdk = "5.2.1"\nsp1-zkvm = "5.2.1"\nsqlx = "0.8.6"\ntermion = "4.0"\nthiserror = "2.0.16"\ntokio = { version = "1.47.1", features = ["full"] }\ntracing = "0.1.41"\ntracing-subscriber = ">=0.3.20"\nurl = "2.5"\nuuid = "1.0"\naxum-prometheus = "0.7"\nmetrics = "0.23"\nmetrics-exporter-prometheus = "0.15"\nmetrics-util = "0.17"\nprometheus = "0.14.0"\naws-config = "1.5"\naws-sdk-s3 = "1.47"\naws-sdk-kms = "1.44"\nmime = "0.3"\nmime_guess = "2.0"\nvalidator = "0.18"' > Cargo.toml

# Copy dependency manifests
COPY db/Cargo.toml ./db/
COPY lib/Cargo.toml ./lib/

# Copy source code for required crates
COPY lib/ ./lib/
COPY db/ ./db/
# Copy SQLx offline query cache for offline compilation
COPY .sqlx/ ./.sqlx/

# Build only the populate_fake_data binary
WORKDIR /app/db
ENV SQLX_OFFLINE=true
RUN cargo build --release --bin populate_fake_data

# Runtime stage - use existing arda-credit image as base
FROM ghcr.io/ardaglobal/arda-credit:latest

# Switch to root to install the population binary
USER root

# Copy the population script binary and migrations
COPY --from=builder /app/target/release/populate_fake_data /app/populate_fake_data
COPY db/migrations /app/migrations

# Set permissions
RUN chown appuser:appuser /app/populate_fake_data && \
    chmod +x /app/populate_fake_data

# Switch back to app user
USER appuser

# Override CMD to run population script
CMD ["/app/populate_fake_data"]