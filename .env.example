# The `SERVER_ENVIRONMENT` variable controls which proof generation method is used for ZK batch processing. This allows for fast local development while maintaining production-ready Sindri integration.
SERVER_ENVIRONMENT=local  # Options: local, staging, sandbox, production

# PostgreSQL Database Connection
# WARNING: These default credentials (postgres:password) are for testing/development only!
# DO NOT use these credentials in production environments.
# For Docker setup (recommended for testing):
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/arda_credit_db
# For custom setup:
# DATABASE_URL=postgresql://username:password@127.0.0.1/arda_credit_db

# Sindri Configuration (required for network proving)
# Get your API key from https://sindri.app
SINDRI_API_KEY=your_sindri_api_key_here

# Optional: Custom circuit name for Sindri (defaults to "arda-credit")
# SINDRI_CIRCUIT_NAME=arda-credit

# Sindri Circuit Tag Configuration
# Specifies which circuit version to use for proof generation
# Set to "latest" to use the most recent deployment (default)
# Or set to a specific tag deployed with ./deploy-circuit.sh <tag>
SINDRI_CIRCUIT_TAG=latest

# Server Configuration
RUST_LOG=debug
SERVER_PORT=8080
ARDA_CREDIT_API_URL=http://0.0.0.0:8080 # for the CLI

# RPC URL (i.e. Alchemy)
ETHEREUM_RPC_URL=http://127.0.0.1:8545 # anvil RPC for local and staging environments

# Contract to interact with
ETHEREUM_CONTRACT_ADDRESS=

# Private key of the Wallet deploying the contract
ETHEREUM_WALLET_PRIVATE_KEY=ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80 # Anvil testing key

# Wallet that deployed the smart contract and thus is authorized to post to it
ETHEREUM_DEPLOYER_ADDRESS=

# Contract address of the SP1 Verifier
VERIFIER_CONTRACT_ADDRESS=0x397A5f7f3dBd538f23DE225B51f532c34448dA9B

# The verifier key for the current zkVM program
PROGRAM_VKEY=0x035a6b230490471fe1a84470ae9bf66a6521fd76d559d50488f30d5b1ccbfc2b

# =============================================================================
# CORE OPENTELEMETRY SETTINGS
# =============================================================================

# Enable or disable OpenTelemetry tracing
ENABLE_OPENTELEMETRY=true

# Service name for traces (will appear in SigNoz/Jaeger)
OTEL_SERVICE_NAME=arda-credit

# =============================================================================
# SIGNOZ CLOUD CONFIGURATION
# =============================================================================

# SigNoz Cloud ingestion key (required for metrics/traces export)
# Get this from your SigNoz Cloud account settings
SIGNOZ_INGESTION_KEY=your-signoz-ingestion-key-here

# SigNoz Cloud endpoints
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.us.signoz.cloud:443/v1/traces
OTLP_DESTINATION_ENDPOINT=ingest.us.signoz.cloud:443

# PostgreSQL monitoring password (matches Helm chart configuration)
POSTGRES_MONITORING_PASSWORD=monitoring-password

# =============================================================================
# GITHUB CONTAINER REGISTRY (GHCR) AUTHENTICATION
# =============================================================================

# GHCR credentials for Docker image access (required for private images)
# Username: Your GitHub username or organization name
GHCR_USERNAME=your_github_username

# Personal Access Token with 'read:packages' scope
# Generate at: https://github.com/settings/tokens
GHCR_TOKEN=your_github_personal_access_token

# Email associated with your GitHub account (for Docker registry authentication)
GHCR_EMAIL=your_email@example.com

# AI
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_SITE_URL=https://arda.xyz
OPENROUTER_SITE_NAME=Arda Credit

# OpenRouter model for AI inference/chat (used for analyzing documents with embeddings)
# Default: anthropic/claude-3.5-sonnet
# Other options: anthropic/claude-3-opus, openai/gpt-4-turbo, google/gemini-pro-1.5, etc.
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# LLM Extraction Configuration (Rust-native)
# Uses one of: OPENAI_API_KEY, ANTHROPIC_API_KEY, or OPENROUTER_API_KEY (configured above)
# Optional: Override default models for document extraction
# OPENAI_EXTRACTION_MODEL=gpt-4o-2024-08-06
# ANTHROPIC_EXTRACTION_MODEL=claude-3-5-sonnet-20241022
# OPENROUTER_EXTRACTION_MODEL=anthropic/claude-3.5-sonnet

# =============================================================================
# SURREALDB DATABASE CONFIGURATION (MULTI-TENANT)
# =============================================================================
# SurrealDB stores document content, metadata, and vectorized embeddings for
# AI-powered search and analysis. Uses MTREE index for fast vector similarity searches.
# Multi-tenant support via company_id partitioning.
#
# IMPORTANT: SurrealDB is automatically connected when you run `make server`
# The server will initialize the schema (documents + embeddings tables) on startup.

# SurrealDB Connection (Hosted Cloud Instance)
SURREALDB_URL=wss://lucky-shadow-06cv56oolpvpb449gc1r4uiug4.aws-use1.surreal.cloud
# Alternative for local development:
# SURREALDB_URL=ws://localhost:8000/rpc

# Authentication
SURREALDB_USERNAME=root
SURREALDB_PASSWORD=your_password_here  # ⚠️ REQUIRED - Get from SurrealDB dashboard

# Database/Namespace Configuration
SURREALDB_NAMESPACE=arda-credit  # Namespace for the application
SURREALDB_DATABASE=idr-docs      # Database name for document storage

# =============================================================================
# EMBEDDING CONFIGURATION (QWen3B via Modal)
# =============================================================================
# Document chunks are converted to vector embeddings for semantic search.
# The QWen3B model is hosted on Modal for optimal performance with in-memory caching.
#
# Key Features:
# - Automatic retry with exponential backoff
# - Rate limiting to prevent endpoint overload
# - In-memory caching to avoid duplicate requests
# - Embedding validation (dimensions, NaN/Inf detection)
# - Comprehensive metrics logging

# EMBEDDING_PROVIDER: Choose embedding provider (openai|modal, default: modal)
EMBEDDING_PROVIDER=modal  # Use Modal-hosted QWen3B embeddings
# EMBEDDING_PROVIDER=openai  # Or use OpenAI directly

# Embedding Model Selection
EMBEDDING_MODEL=qwen3-embedding-8b  # Model architecture (lowercase required by Modal)
# Options: text-embedding-3-small (1536 dims), text-embedding-3-large (3072 dims), text-embedding-ada-002 (1536 dims)
EMBEDDING_DIMENSIONS=4096  # Must match the model output

# Batch Processing Configuration
EMBEDDING_BATCH_SIZE=50  # Chunks per request (Modal optimized: 50, OpenAI: 100)
# Lower batch sizes may improve reliability, higher batch sizes improve throughput

# Modal QWen3B Endpoint Configuration (when EMBEDDING_PROVIDER=modal)
MODAL_EMBEDDING_URL=https://ardaglobal--embed.modal.run/
# Optional: Modal API key if endpoint requires authentication
# MODAL_API_KEY=your_modal_api_key_here

# Caching Configuration
# In-memory cache automatically stores embeddings to avoid re-requesting duplicate chunks
# Cache is automatically managed (no configuration needed)
# Typical cache hit rate: 5-15% for document processing

# Rate Limiting (prevents overwhelming the Modal endpoint)
# MODAL_MAX_CONCURRENT_REQUESTS=10  # Maximum parallel requests (default: 10)
# MODAL_MIN_REQUEST_DELAY_MS=100    # Minimum milliseconds between requests (default: 100ms)

# Retry Configuration (handles transient failures gracefully)
# MODAL_MAX_RETRIES=3                # Maximum retry attempts (default: 3)
# MODAL_INITIAL_BACKOFF_MS=100       # Initial retry delay in milliseconds (default: 100ms)
# MODAL_MAX_BACKOFF_MS=10000         # Maximum retry delay in milliseconds (default: 10s)
# MODAL_BACKOFF_MULTIPLIER=2.0       # Exponential backoff multiplier (default: 2.0)

# OpenAI Configuration (when EMBEDDING_PROVIDER=openai)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_API_BASE_URL=https://api.openai.com/v1

# =============================================================================
# MODAL AI AGENT CONFIGURATION
# =============================================================================
# Modal hosts the i2p-agent which handles:
# - Document vectorization and embedding generation
# - SurrealDB vector search
# - LLM inference for insight generation
# The agent communicates with your hosted SurrealDB instance.

# Modal agent endpoint for insight generation
MODAL_AGENT_ENDPOINT=https://ardaglobal--i2p-agent-generate-insights.modal.run

# Optional: Modal API key for authenticated requests
MODAL_API_KEY=your_modal_api_key_here

# =============================================================================
# DOCUMENT INGESTION JOB QUEUE CONFIGURATION
# =============================================================================
# Background worker polls SurrealDB for pending documents and processes them
# asynchronously through the parsing → chunking → embedding → storage pipeline.

# Job Queue Worker Settings
JOB_QUEUE_POLL_INTERVAL_SECS=5        # How often to poll for new documents (default: 5)
JOB_QUEUE_MAX_CONCURRENT=4            # Maximum concurrent document processing jobs (default: 4)
JOB_QUEUE_MAX_RETRIES=3               # Maximum retry attempts per document (default: 3)
JOB_QUEUE_FETCH_BATCH_SIZE=10         # Number of documents to fetch per poll (default: 10)

# Retry Configuration (Exponential Backoff)
JOB_QUEUE_INITIAL_BACKOFF_MS=1000     # Initial retry delay in milliseconds (default: 1000ms)
JOB_QUEUE_MAX_BACKOFF_MS=60000        # Maximum retry delay in milliseconds (default: 60s)
JOB_QUEUE_BACKOFF_MULTIPLIER=2.0      # Backoff multiplier for exponential backoff (default: 2.0)

# =============================================================================
# Magic Link Email Login
# =============================================================================

# Magic Link Configuration
# `MAGIC_BASE_URL`: The base URL for magic link verification (where users are redirected, should be the frontend URL)
MAGIC_BASE_URL=https://app.stag.aws.arda.xyz/auth/verify # Production
# MAGIC_BASE_URL=http://localhost:3000/auth/verify # Development
# `MAGIC_LINK_TTL_MINUTES`: How long magic links are valid (default: 10 minutes)
MAGIC_LINK_TTL_MINUTES=10
# `MAGIC_LINK_MAX_TOKENS_PER_USER`: Maximum concurrent active magic links per user (default: 3)
MAGIC_LINK_MAX_TOKENS_PER_USER=3

# AWS SES Configuration (for email sending)
# `SES_REGION`: AWS region where SES is configured
SES_REGION=us-east-1
# `EMAIL_FROM`: From address for magic link emails
EMAIL_FROM=no-reply@mail.auth.arda.xyz
# `EMAIL_REPLY_TO`: Reply-to address for support
EMAIL_REPLY_TO=support@arda.xyz

# Session Configuration
# `SESSION_EXPIRY_DAYS`: How long user sessions remain valid (default: 30 days)
SESSION_EXPIRY_DAYS=30
# `SESSION_COOKIE_DOMAIN`: Domain for session cookies (should match your app domain)
SESSION_COOKIE_DOMAIN=.stag.aws.arda.xyz # Production
# SESSION_COOKIE_DOMAIN=localhost # Development

# AWS Credentials (get these from your DevOps engineer)
# You can verify your AWS access with `aws ses get-account-sending-enabled --region us-east-1`
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1  # Should match SES_REGION

# Email Debug Configuration
EMAIL_DEBUG_MODE=false # set to true to bypass the email sending and get the link logged to the terminal
EMAIL_ENABLED=true

# =============================================================================
# MCP PROXY CONFIGURATION (FastMCP)
# =============================================================================
# MCP (Model Context Protocol) Proxy provides a bridge between your application
# and MCP servers for AI-powered insights and document analysis.
# The proxy runs on port 8000 and is managed via docker-compose.

# MCP Server URL (the upstream MCP server to proxy to)
MCP_SERVER_URL=https://arda-insights.fastmcp.app/mcp

# API Keys for securing the MCP proxy (comma-separated list)
# SECURITY: Change these default keys in production!
MCP_PROXY_API_KEYS=dev-key-123,prod-key-456

# CORS Origins (comma-separated list of allowed origins)
MCP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# MCP Proxy timeout in seconds (default: 30.0)
MCP_TIMEOUT=30.0

# Debug mode for MCP proxy (default: false)
MCP_DEBUG=false

# Log level for MCP proxy (default: INFO)
# Options: DEBUG, INFO, WARNING, ERROR
MCP_LOG_LEVEL=INFO
