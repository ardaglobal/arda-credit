# The `SERVER_ENVIRONMENT` variable controls which proof generation method is used for ZK batch processing. This allows for fast local development while maintaining production-ready Sindri integration.
# Options:
#   - local: Core proofs with local SP1 prover, no smart contract posting (fast development)
#   - dev: Core proofs with local SP1 prover, no smart contract posting (development environment)
#   - staging: Sindri/Groth16 proofs with smart contract posting on Anvil (full workflow testing)
#   - sandbox: Sindri/Groth16 proofs with smart contract posting on Sepolia testnet
#   - production: Sindri/Groth16 proofs with smart contract posting on Ethereum mainnet
SERVER_ENVIRONMENT=local

# PostgreSQL Database Connection
# WARNING: These default credentials (postgres:password) are for testing/development only!
# DO NOT use these credentials in production environments.
# For Docker setup (recommended for testing):
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/arda_credit_db
# For custom setup:
# DATABASE_URL=postgresql://username:password@127.0.0.1/arda_credit_db

# Sindri Configuration (required for network proving)
# Get your API key from https://sindri.app
SINDRI_API_KEY=your_sindri_api_key_here

# Optional: Custom circuit name for Sindri (defaults to "arda-credit")
# SINDRI_CIRCUIT_NAME=arda-credit

# Sindri Circuit Tag Configuration
# Specifies which circuit version to use for proof generation
# Set to "latest" to use the most recent deployment (default)
# Or set to a specific tag deployed with ./deploy-circuit.sh <tag>
SINDRI_CIRCUIT_TAG=latest

# Server Configuration
RUST_LOG=debug
SERVER_PORT=8080
ARDA_CREDIT_API_URL=http://0.0.0.0:8080 # for the CLI

# RPC URL (i.e. Alchemy)
ETHEREUM_RPC_URL=http://127.0.0.1:8545 # anvil RPC for local and staging environments

# Contract to interact with
ETHEREUM_CONTRACT_ADDRESS=

# Private key of the Wallet deploying the contract
ETHEREUM_WALLET_PRIVATE_KEY=ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80 # Anvil testing key

# Wallet that deployed the smart contract and thus is authorized to post to it
ETHEREUM_DEPLOYER_ADDRESS=

# Contract address of the SP1 Verifier
VERIFIER_CONTRACT_ADDRESS=0x397A5f7f3dBd538f23DE225B51f532c34448dA9B

# The verifier key for the current zkVM program
PROGRAM_VKEY=0x035a6b230490471fe1a84470ae9bf66a6521fd76d559d50488f30d5b1ccbfc2b

# =============================================================================
# CORE OPENTELEMETRY SETTINGS
# =============================================================================

# Enable or disable OpenTelemetry tracing
ENABLE_OPENTELEMETRY=true

# Service name for traces
OTEL_SERVICE_NAME=arda-credit

# PostgreSQL monitoring password (matches Helm chart configuration)
POSTGRES_MONITORING_PASSWORD=monitoring-password

# =============================================================================
# GITHUB CONTAINER REGISTRY (GHCR) AUTHENTICATION
# =============================================================================

# GHCR credentials for Docker image access (required for private images)
# Username: Your GitHub username or organization name
GHCR_USERNAME=your_github_username

# Personal Access Token with 'read:packages' scope
# Generate at: https://github.com/settings/tokens
GHCR_TOKEN=your_github_personal_access_token

# Email associated with your GitHub account (for Docker registry authentication)
GHCR_EMAIL=your_email@example.com

# =============================================================================
# Magic Link Email Login
# =============================================================================

# Magic Link Configuration
# `MAGIC_BASE_URL`: The base URL for magic link verification (where users are redirected, should be the frontend URL)
MAGIC_BASE_URL=https://app.stag.aws.arda.xyz/auth/verify # Production
# MAGIC_BASE_URL=http://localhost:3000/auth/verify # Development
# `MAGIC_LINK_TTL_MINUTES`: How long magic links are valid (default: 10 minutes)
MAGIC_LINK_TTL_MINUTES=10
# `MAGIC_LINK_MAX_TOKENS_PER_USER`: Maximum concurrent active magic links per user (default: 3)
MAGIC_LINK_MAX_TOKENS_PER_USER=3

# AWS SES Configuration (for email sending)
# `SES_REGION`: AWS region where SES is configured
SES_REGION=us-east-1
# `EMAIL_FROM`: From address for magic link emails
EMAIL_FROM=no-reply@mail.auth.arda.xyz
# `EMAIL_REPLY_TO`: Reply-to address for support
EMAIL_REPLY_TO=support@arda.xyz

# Session Configuration
# `SESSION_EXPIRY_DAYS`: How long user sessions remain valid (default: 30 days)
SESSION_EXPIRY_DAYS=30
# `SESSION_COOKIE_DOMAIN`: Domain for session cookies (should match your app domain)
SESSION_COOKIE_DOMAIN=.stag.aws.arda.xyz # Production
# SESSION_COOKIE_DOMAIN=localhost # Development

# AWS Credentials (get these from your DevOps engineer)
# You can verify your AWS access with `aws ses get-account-sending-enabled --region us-east-1`
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1  # Should match SES_REGION

# Email Debug Configuration
EMAIL_DEBUG_MODE=false # set to true to bypass the email sending and get the link logged to the terminal
EMAIL_ENABLED=true

# =============================================================================
# MCP PROXY CONFIGURATION (FastMCP)
# =============================================================================
# MCP (Model Context Protocol) Proxy provides a bridge between your application
# and MCP servers for AI-powered insights and document analysis.
# The proxy runs on port 8000 and is managed via docker-compose.

# Application Settings
MCP_DEBUG=false

# Server Configuration
# Path to the servers.yaml file containing MCP server definitions
MCP_SERVERS_CONFIG_PATH=servers.yaml

# Authentication Settings
# Set to false to disable API key authentication (development only!)
# WARNING: Never set to false in production environments
MCP_AUTH_ENABLED=true

# API Keys (JSON array format)
# Multiple keys can be specified for different clients/services
MCP_API_KEYS=["dev-key-123","your-api-key-here"]

# CORS Settings (JSON array format)
MCP_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
MCP_CORS_ALLOW_CREDENTIALS=true
MCP_CORS_ALLOW_METHODS=["*"]
MCP_CORS_ALLOW_HEADERS=["*"]

# Logging
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
MCP_LOG_LEVEL=INFO

# Collateral service
COLLATERAL_INTEL_SERVICE_URL=http://localhost:3010
