  "query": "\n        SELECT id, user_id, transaction_type, amount, currency,\n               transaction_hash, blockchain_status, block_number, processed_at\n        FROM account_financial_transactions\n        WHERE user_id = $1\n        ORDER BY processed_at DESC\n        LIMIT $2 OFFSET $3\n        ",
