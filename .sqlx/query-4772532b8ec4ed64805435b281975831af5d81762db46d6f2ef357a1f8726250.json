{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT d.id, d.investor_id, d.loan_status, d.principal_amount,\n               dl.asking_price, dl.status as listing_status\n        FROM deals d\n        LEFT JOIN deal_listings dl ON d.id = dl.deal_id AND dl.status = 'active'\n        WHERE d.id = $1\n        ",
