{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                value as nullifier_value,\n                loan_operation_type as operation_type,\n                operation_amount,\n                created_at as operation_timestamp,\n                tree_index,\n                batch_id,\n                user_id,\n                operation_metadata\n            FROM nullifiers\n            WHERE loan_id = $1\n                AND loan_operation_type IS NOT NULL\n                AND is_active = true\n            ORDER BY created_at DESC\n            LIMIT $2\n            ",
