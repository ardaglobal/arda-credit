{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT l.id, l.lender_id, l.loan_status, l.principal_amount,\n               ll.asking_price, ll.status as listing_status\n        FROM loans l\n        LEFT JOIN loan_listings ll ON l.id = ll.loan_id AND ll.status = 'active'\n        WHERE l.id = $1\n        ",
