  "query": "\n        SELECT id, user_type, email, kyc_status, kyc_submitted_at, kyc_verified_at, \n               created_at, updated_at, first_name, last_name, jurisdiction, wallet_address\n        FROM users\n        WHERE deleted_at IS NULL\n        ORDER BY created_at DESC\n        LIMIT $1 OFFSET $2\n        ",
