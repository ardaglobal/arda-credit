  "query": "\n        SELECT dt.deal_id, dt.from_investor_id, dt.to_investor_id, dt.transfer_status\n        FROM deal_transfers dt\n        WHERE dt.transfer_id = $1\n          AND (dt.from_investor_id = $2 OR dt.to_investor_id = $2)\n          AND dt.transfer_status = 'pending'\n        ",
