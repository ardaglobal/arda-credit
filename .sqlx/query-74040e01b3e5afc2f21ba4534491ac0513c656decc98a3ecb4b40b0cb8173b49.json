{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT \n            ct.transaction_id,\n            ct.collateral_id,\n            ct.transaction_type,\n            ct.created_at,\n            ct.created_by,\n            u.email as \"user_email?\",\n            ct.deal_id,\n            ct.metadata\n        FROM collateral_transactions ct\n        LEFT JOIN users u ON ct.created_by = u.id\n        WHERE ct.collateral_id = $1\n        ORDER BY ct.created_at ASC\n        LIMIT $2\n        ",
