{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            id,\n            originator_id,    -- Company ID of originator\n            investor_id,      -- Company ID of investor (optional)\n            principal_amount,\n            outstanding_balance,\n            interest_rate_bps,\n            deal_status,\n            originated_at,\n            maturity_date,\n            created_at,\n            updated_at,\n            custom_deal_id,\n            status,\n            industry,\n            document_ids,\n            title,\n            description,\n            risk_level,\n            asset_class,\n            region,\n            minimum_investment,\n            payment_frequency,\n            collateral_type,\n            collateral_value,\n            ltv_ratio,\n            credit_score,\n            dscr,\n            state_transition_hash,\n            proof_included\n        FROM deals  -- was loans\n        WHERE ($1::text IS NULL OR deal_status = $1)\n          AND ($2::uuid IS NULL OR originator_id = $2)  -- Company ID filter\n          AND ($3::uuid IS NULL OR investor_id = $3)    -- Company ID filter\n          AND ($4::text IS NULL OR industry = $4)\n        ORDER BY created_at DESC\n        LIMIT $5 OFFSET $6\n        ",
