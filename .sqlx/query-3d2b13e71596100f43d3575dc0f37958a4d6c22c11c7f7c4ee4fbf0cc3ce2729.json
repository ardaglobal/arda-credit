  "query": "\n        INSERT INTO balances (identity_id, balance_type, amount, currency)\n        VALUES ($1, $2, $4, $3)\n        ON CONFLICT (identity_id, balance_type, currency)\n        DO UPDATE SET amount = $4, updated_at = NOW()\n        RETURNING id, identity_id, balance_type, amount, currency, updated_at, created_at\n        ",
