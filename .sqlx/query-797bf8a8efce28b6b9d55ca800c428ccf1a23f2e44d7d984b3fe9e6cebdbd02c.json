{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT \n            updated_at as \"timestamp!: DateTime<Utc>\",\n            total_deposits,\n            available_liquidity,\n            utilized_liquidity,\n            CASE \n                WHEN total_deposits > 0 THEN (utilized_liquidity / total_deposits)\n                ELSE NULL \n            END as \"utilization_rate\"\n        FROM liquidity_pools\n        WHERE id = $1\n        ",
