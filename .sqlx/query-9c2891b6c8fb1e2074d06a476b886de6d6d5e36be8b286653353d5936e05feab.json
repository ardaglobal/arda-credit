{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT\n                    id, value, next_index, next_value, tree_index, created_at as \"created_at!\", is_active as \"is_active!: bool\",\n                    loan_operation_type, loan_id, user_id, operation_amount, operation_metadata, batch_id as \"batch_id: Option<i32>\"\n                FROM nullifiers\n                WHERE user_id = $1\n                    AND loan_operation_type IS NOT NULL\n                    AND is_active = true\n                ORDER BY created_at DESC\n                LIMIT $2\n                ",
