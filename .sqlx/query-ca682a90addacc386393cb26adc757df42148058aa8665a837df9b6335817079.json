{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            id,\n            originator_id,\n            investor_id,\n            principal_amount,\n            outstanding_balance,\n            interest_rate_bps,\n            loan_status,\n            originated_at,\n            maturity_date,\n            created_at,\n            updated_at,\n            custom_deal_id,\n            title,\n            description,\n            risk_level,\n            asset_class,\n            region,\n            minimum_investment\n        FROM deals\n        WHERE (originator_id = $1 OR investor_id = $1)\n          AND ($2::text IS NULL OR loan_status = $2)\n        ORDER BY created_at DESC\n        LIMIT $3 OFFSET $4\n        ",
