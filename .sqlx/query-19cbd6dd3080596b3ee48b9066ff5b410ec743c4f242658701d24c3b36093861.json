  "query": "\n        INSERT INTO pool_borough_limits (pool_id, borough, max_percentage, current_allocated)\n        VALUES ($1, $2, $3, 0)\n        ON CONFLICT (pool_id, borough)\n        DO UPDATE SET\n            max_percentage = $3,\n            updated_at = NOW()\n        RETURNING id, pool_id, borough, max_percentage, current_allocated, created_at, updated_at\n        ",
