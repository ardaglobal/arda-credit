  "query": "\n        SELECT \n            id,\n            transaction_type,\n            transaction_data,\n            user_id,\n            deal_id,\n            originator_company_id,\n            investor_company_id,\n            collateral_id,\n            included_in_batch_id,\n            created_at as \"created_at!\",\n            updated_at as \"updated_at!\"\n        FROM state_transactions\n        WHERE investor_company_id = $1\n        ORDER BY created_at ASC, id ASC\n        LIMIT $2\n        ",
