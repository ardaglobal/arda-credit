  "query": "\n                SELECT\n                    event_id as \"event_id!\",\n                    deal_id as loan_id,\n                    user_id,\n                    loan_operation_type,\n                    operation_amount,\n                    nullifier_value as \"nullifier_value!\",\n                    \"timestamp\" as \"timestamp!\",\n                    batch_id,\n                    transaction_hash,\n                    root_before as \"root_before!\",\n                    root_after as \"root_after!\",\n                    metadata,\n                    principal_amount,\n                    outstanding_balance,\n                    loan_status,\n                    originated_at,\n                    user_email,\n                    user_type,\n                    kyc_status\n                FROM deal_audit_comprehensive\n                WHERE deal_id = $1\n                ORDER BY \"timestamp\" DESC\n                LIMIT $2\n                ",
