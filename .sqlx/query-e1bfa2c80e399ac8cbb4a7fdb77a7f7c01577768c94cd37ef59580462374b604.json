{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            cm.company_id,\n            c.name as company_name,\n            cm.role,\n            cm.status,\n            cm.profile_type,\n            cm.accepted_at as joined_at\n        FROM company_memberships cm\n        JOIN companies c ON cm.company_id = c.id\n        WHERE cm.user_id = $1\n        ORDER BY cm.created_at DESC\n        ",
