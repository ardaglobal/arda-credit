  "query": "\n            SELECT tm.*, c.kyb_status, i.kyc_status\n            FROM team_members tm\n            JOIN companies c ON tm.company_id = c.id\n            JOIN identities i ON tm.user_id = i.id\n            WHERE tm.user_id = $1 AND tm.company_id = $2 AND tm.status = 'active'\n            ",
