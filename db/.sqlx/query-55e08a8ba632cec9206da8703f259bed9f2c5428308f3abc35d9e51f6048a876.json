  "query": "\n                SELECT pb.id, pb.created_at as \"created_at!\", ads.merkle_root\n                FROM proof_batches pb\n                JOIN ads_state_commits ads ON pb.id = ads.batch_id\n                JOIN audit_events ae ON ae.nullifier_value = $1\n                WHERE pb.id = $2\n                ",
